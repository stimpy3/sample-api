# The freshness check compares generated bytes against the committed file.
# If git rewrites line endings on checkout, that comparison fails on Windows
# for reasons that have nothing to do with the API contract.
*.yaml text eol=lf
*.yml  text eol=lf
*.py   text eol=lf
*.sh   text eol=lf
Dockerfile text eol=lf
Jenkinsfile text eol=lf
